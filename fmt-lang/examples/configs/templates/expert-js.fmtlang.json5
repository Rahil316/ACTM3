// Template 2 — the expert path. A JS object literal, sorted alphabetically
// by color, grouped by color with a comment header per group, camelCase
// naming, only the Light theme.
{
  "defs": {
    "naming": {
      "camelToken": { "appliesTo": "token", "segments": ["color", "role", "variation"], "case": "camel" }
    },
    "sort": {
      "byColorName": { "keys": [{ "by": "color.name", "order": "alpha" }] }
    },
    "arrange": {
      "groupedByColor": {
        "kind": "nested",
        "groupBy": ["color.name"],
        "indent": 2,
        "groupHeaderTemplate": "  // ${group}"
      }
    },
    "entryFormat": {
      "jsProp": { "preset": "jsObjectProperty" }
    }
  },
  "files": [
    {
      "role": "tokens",
      "shape": "token",
      "path": "tokens.js",
      "select": { "shape": "token", "where": "theme == 'light'" },
      "sort": "byColorName",
      "arrange": "groupedByColor",
      "naming": "camelToken",
      "entryFormat": "jsProp",
      "before": "// Auto-generated by fmt-lang. Do not edit manually.\nexport const lightTokens = {",
      "after": "};"
    }
  ]
}
