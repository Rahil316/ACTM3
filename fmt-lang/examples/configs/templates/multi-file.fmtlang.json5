// Template 3 — multi-file + cross-file references. One CSS file per theme
// (repeatFor), plus an index file that imports all of them by their REAL
// resolved names — the "aggregator" pattern (B.12).
{
  "defs": {
    "static": {
      "doNotEdit": { "text": "/* Auto-generated by fmt-lang. Do not edit manually. */" }
    }
  },
  "files": [
    {
      "role": "theme-file",
      "shape": "token",
      "repeatFor": { "over": "themes", "as": "theme" },
      "path": "themes/${theme}.css",
      "content": ":root {\n${tokensCss.getEntriesByTheme(theme)}\n}\n",
      "before": "doNotEdit"
    },
    {
      "role": "index",
      "shape": "token",
      "path": "themes/index.css",
      "content": "{{files.theme-file.each}}@import './{{item.name}}';\n{{/files.theme-file.each}}",
      "before": "doNotEdit"
    }
  ]
}
